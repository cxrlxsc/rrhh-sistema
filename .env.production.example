# =====================================================================
#  PLANTILLA DE VARIABLES PARA PRODUCCIÓN (cPanel / hosting compartido)
#  Copiar como .env en el servidor y completar los valores reales.
#  NUNCA subir este archivo con credenciales al repositorio.
# =====================================================================

APP_NAME="Sistema RRHH"
APP_ENV=production
# Generar en el servidor con: php artisan key:generate
APP_KEY=
# DEBUG SIEMPRE EN FALSE: en true se exponen rutas, .env y trazas de error.
APP_DEBUG=false
APP_URL=https://tudominio.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES
APP_TIMEZONE=America/El_Salvador

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# --- Logs: en producción se rota por día y se baja el nivel de detalle ---
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# --- Base de datos MySQL de cPanel ---
# El usuario y la base llevan el prefijo de la cuenta cPanel: usuario_basedatos
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpaneluser_rrhh
DB_USERNAME=cpaneluser_rrhh
DB_PASSWORD=

# --- Sesión y caché ---
# 'database' funciona en hosting compartido sin Redis.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.tudominio.com
# Obliga a que la cookie de sesión viaje solo por HTTPS.
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Correo (cPanel: cuenta creada en "Email Accounts") ---
MAIL_MAILER=smtp
MAIL_HOST=mail.tudominio.com
MAIL_PORT=465
MAIL_USERNAME=no-reply@tudominio.com
MAIL_PASSWORD=
MAIL_SCHEME=smtps
MAIL_FROM_ADDRESS="no-reply@tudominio.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Datos de la empresa (aparecen en los recibos PDF) ---
EMPRESA_NOMBRE="Mi Empresa S.A. de C.V."
EMPRESA_NIT=0614-000000-000-0
EMPRESA_NRC=000000-0
EMPRESA_DIRECCION="San Salvador, El Salvador"

# --- Kiosco de marcaje ---
ASISTENCIA_HORA_LIMITE=08:00
ASISTENCIA_TOLERANCIA=5
KIOSCO_COOLDOWN=60
KIOSCO_JORNADA_MINIMA=60
KIOSCO_RATE_LIMIT=20
# Token largo y aleatorio: la tablet entra con https://tudominio.com/kiosco?token=...
KIOSCO_TOKEN=

VITE_APP_NAME="${APP_NAME}"
